# Copy this file to `.env.local` (and Vercel → Settings → Environment Variables)

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-08-21
NEXT_PUBLIC_SITE_URL=https://chrismachinery.com
# Local Studio. On Vercel set to your hosted Studio, e.g. https://chris-machinery.sanity.studio
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
# Presentation preview of the live site (Vercel URL). Local default is http://localhost:3000
SANITY_STUDIO_PREVIEW_ORIGIN=https://chrismachinery.com

# Studio + inquiry writes (Settings → API → Tokens, Editor role). Required on Vercel or contact form returns 503.
SANITY_API_WRITE_TOKEN=

# Visual Editing / Presentation (Viewer token + preview handshake)
SANITY_API_READ_TOKEN=
SANITY_PREVIEW_SECRET=

# Required on Vercel. Protects /api/admin/*
ADMIN_KEY=

# Optional: POST inquiry JSON to Slack/Make
LEADS_WEBHOOK_URL=
